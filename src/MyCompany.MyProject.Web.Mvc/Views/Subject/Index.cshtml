@{
    ViewBag.Title = "Quản lý Môn học";
}
@section scripts {
    <script src="~/view-resources/Views/Subject/Index.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6"><h1>Danh sách Môn học</h1></div>
            <div class="col-sm-6 text-right">
                <button type="button" id="btnCreateSubject" class="btn btn-primary">
                    <i class="fa fa-plus-square"></i> Thêm Môn học
                </button>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body table-responsive">
                <table id="SubjectTable" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Mã môn</th>
                            <th>Tên môn</th>
                            <th>Hệ số môn</th>
                            <th style="width: 150px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="SubjectCreateModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Thêm Môn học</h5>
                <button type="button" class="close" id="btnCloseSubjectModal">&times;</button>
            </div>

            <form id="SubjectCreateForm">
                <div class="modal-body">

                    <div class="form-group">
                        <label>Mã môn học</label>
                        <input type="text"
                               name="Code"
                               class="form-control"
                               placeholder="Ví dụ: TOAN10"
                               required />
                    </div>

                    <div class="form-group">
                        <label>Tên môn học</label>
                        <input type="text"
                               name="Name"
                               class="form-control"
                               placeholder="Ví dụ: Toán học"
                               required />
                    </div>

                    <div class="form-group">
                        <label>Hệ số</label>
                        <input type="number"
                               name="Factor"
                               class="form-control"
                               value="1"
                               min="1"
                               max="5"
                               required />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            id="btnCancelSubjectModal">
                        Hủy
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Lưu
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>